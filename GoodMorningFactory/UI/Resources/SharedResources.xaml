<!-- GoodMorningFactory/UI/Resources/SharedResources.xaml -->
<!-- *** الكود الكامل والمؤكد - يحتوي على جميع المحولات المطلوبة *** -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters">

	<!-- قائمة المحولات الكاملة -->
    <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    <converters:AmountToColorConverter x:Key="AmountToColorConverter"/>
    <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
    <converters:IndentConverter x:Key="IndentConverter" IndentSize="20"/>
    <converters:VarianceToColorConverter x:Key="VarianceToColorConverter"/>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
    <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
	<converters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter"/>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

	<!-- الأنماط (Styles) -->
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#005A9C"/>
        <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#0078D4"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#005A9C"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Gray"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#E1E1E1"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Padding" Value="15,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderBrush" Value="#ADADAD"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CACACA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F9F9F9"/>
        <Setter Property="BorderBrush" Value="#E0E0E0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="DataGridStyle" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="GridLinesVisibility" Value="All"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
        <Setter Property="VerticalGridLinesBrush" Value="#E0E0E0"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
    </Style>
    <Style x:Key="FilterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#F0F0F0"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="TotalsBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#E8F5E9"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="BorderBrush" Value="#A5D6A7"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TotalLabelStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="TotalValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="RightAlignedCellStyle" TargetType="TextBlock">
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#4A5568"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" x:Key="StartButtonStyle">
        <Setter Property="Background" Value="#38A169"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" x:Key="ConsumeButtonStyle">
        <Setter Property="Background" Value="#DD6B20"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" x:Key="ReportButtonStyle">
        <Setter Property="Background" Value="#3182CE"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}" x:Key="CancelButtonStyle">
        <Setter Property="Background" Value="#E53E3E"/>
    </Style>

</ResourceDictionary>