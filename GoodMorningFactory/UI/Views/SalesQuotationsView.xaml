<UserControl x:Class="GoodMorningFactory.UI.Views.SalesQuotationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:s="clr-namespace:GoodMorningFactory.Core.Services"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5" FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=vm:SalesQuotationsViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button Content="➕ إنشاء عرض سعر جديد" Margin="5" Padding="5" Command="{Binding AddQuotationCommand}"/>
                <Separator/>
                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Width="120" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="من:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Width="120" SelectedDate="{Binding FromDate}"/>
                <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker Width="120" SelectedDate="{Binding ToDate}"/>
            </ToolBar>
        </ToolBarTray>

        <DataGrid ItemsSource="{Binding Quotations}" Grid.Row="1" Margin="0,10,0,0"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم العرض" Binding="{Binding QuotationNumber}" Width="*"/>
                <DataGridTextColumn Header="العميل" Binding="{Binding Customer.CustomerName}" Width="2*"/>
                <DataGridTextColumn Header="تاريخ العرض" Binding="{Binding QuotationDate, StringFormat='d'}" Width="*"/>
                <DataGridTextColumn Header="تاريخ الصلاحية" Binding="{Binding ValidUntilDate, StringFormat='d'}" Width="*"/>
                <DataGridTemplateColumn Header="الإجمالي" Width="*" SortMemberPath="TotalAmount">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Right" Margin="4,0,0,0">
                                <Run Text="{Binding TotalAmount, StringFormat=N2}"/>
                                <Run Text="{x:Static s:AppSettings.DefaultCurrencySymbol}" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="الحالة" Binding="{Binding Status, Converter={StaticResource EnumToDescriptionConverter}}" Width="*"/>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Margin="2" Command="{Binding DataContext.EditQuotationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="تحويل إلى أمر بيع" Margin="2" Command="{Binding DataContext.ConvertToOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightGreen"/>
                                <Button Content="طباعة" Margin="2" Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightGray"/>
                                <Button Content="حذف" Margin="2" Command="{Binding DataContext.DeleteQuotationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightCoral"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="5" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="&lt; السابق" Margin="5,0" Command="{Binding PreviousPageCommand}"/>
                    <Button Content="التالي &gt;" Margin="5,0" Command="{Binding NextPageCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding PageInfo}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>