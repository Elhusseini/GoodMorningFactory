<UserControl x:Class="GoodMorningFactory.UI.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             xmlns:s="clr-namespace:GoodMorningFactory.Core.Services"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="#F5F5F5"
             d:DataContext="{d:DesignInstance Type=vm:CustomersViewViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Screen Title and Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="إدارة العملاء" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="➕ إضافة عميل جديد" Margin="20,0,0,0" Command="{Binding AddCustomerCommand}"/>
            <Button Content="📁 تصدير إلى CSV" Margin="10,0,0,0" Command="{Binding ExportToCsvCommand}" Background="#107C10" Foreground="White"/>
        </StackPanel>

        <!-- 2. Filters and Search Section -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
            <ToolBarTray>
                <ToolBar>
                    <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                    <TextBox Width="250" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                    <Separator Margin="10,0"/>
                    <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                    <ComboBox Width="120" 
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Name"/>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <!-- 3. Customers DataGrid -->
        <DataGrid Grid.Row="2" Margin="0,10,0,0"
                  ItemsSource="{Binding Customers}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="كود العميل" Binding="{Binding CustomerCode}" Width="*"/>
                <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="2*"/>
                <DataGridTextColumn Header="شخص الاتصال" Binding="{Binding ContactPerson}" Width="*"/>
                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridTemplateColumn Header="الرصيد الحالي" Width="*" SortMemberPath="CurrentBalance">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Right" Margin="4,0,4,0">
                                <Run Text="{Binding CurrentBalance, StringFormat=N2}"/>
                                <Run Text=" "/>
                                <Run Text="{x:Static s:AppSettings.DefaultCurrencySymbol}" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="الحالة" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- *** بداية الإصلاح: تمت إضافة CommandParameter لكل زر *** -->
                                <Button Content="تعديل" Margin="2" Command="{Binding DataContext.EditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="عرض كشف حساب" Margin="2" Command="{Binding DataContext.ViewStatementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightBlue"/>
                                <Button Content="حذف" Margin="2" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightCoral"/>
                                <!-- *** نهاية الإصلاح *** -->
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 4. Pagination Bar -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="&lt; السابق" Margin="5,0" Command="{Binding PreviousPageCommand}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding PageInfo}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="التالي &gt;" Margin="5,0" Command="{Binding NextPageCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
