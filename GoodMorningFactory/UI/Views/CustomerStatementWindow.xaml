<Window x:Class="GoodMorningFactory.UI.Views.CustomerStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CustomerStatementViewModel, IsDesignTimeCreatable=False}"
        Title="كشف حساب العميل" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">

	<Window.Resources>
		<!-- تعريف محول الألوان لاستخدامه في الواجهة -->
		<converters:AmountToColorConverter x:Key="AmountToColorConverter"/>
	</Window.Resources>

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- *** بداية التعديل: تم إحاطة المحتوى في Grid للطباعة *** -->
		<Grid Grid.Row="0" x:Name="PrintableArea">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<TextBlock Grid.Row="0" Text="{Binding CustomerName}" FontSize="18" FontWeight="Bold" Margin="5"/>

			<DataGrid Grid.Row="1" ItemsSource="{Binding StatementItems}" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False">
				<DataGrid.Columns>
					<DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='yyyy/MM/dd'}" Width="*"/>
					<DataGridTextColumn Header="نوع الحركة" Binding="{Binding TransactionType}" Width="1.5*"/>
					<DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceNumber}" Width="*"/>
					<DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2}" Width="*"/>
					<DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2}" Width="*"/>
					<DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="*" FontWeight="Bold"/>
				</DataGrid.Columns>
			</DataGrid>

			<!-- *** بداية الإضافة: قسم الملخص لعرض الإجماليات *** -->
			<Border Grid.Row="2" BorderBrush="Gray" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="5">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" Orientation="Horizontal">
						<TextBlock Text="إجمالي مدين: " FontWeight="Bold"/>
						<TextBlock Text="{Binding TotalDebit, StringFormat=N2}"/>
					</StackPanel>
					<StackPanel Grid.Column="1" Orientation="Horizontal">
						<TextBlock Text="إجمالي دائن: " FontWeight="Bold"/>
						<TextBlock Text="{Binding TotalCredit, StringFormat=N2}"/>
					</StackPanel>
					<StackPanel Grid.Column="2" Orientation="Horizontal">
						<TextBlock Text="الرصيد النهائي: " FontWeight="Bold"/>
						<TextBlock Text="{Binding FinalBalance, StringFormat=N2}"
                                   Foreground="{Binding FinalBalance, Converter={StaticResource AmountToColorConverter}}"/>
					</StackPanel>
				</Grid>
			</Border>
			<!-- *** نهاية الإضافة *** -->
		</Grid>
		<!-- *** نهاية التعديل *** -->

		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
			<!-- *** بداية التعديل: ربط الأوامر بشكل صحيح *** -->
			<Button Content="طباعة" Width="100" Margin="5"
                    Command="{Binding PrintCommand}"
                    CommandParameter="{Binding ElementName=PrintableArea}"/>
			<Button Content="إغلاق" Width="100" Margin="5"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
			<!-- *** نهاية التعديل *** -->
		</StackPanel>
	</Grid>
</Window>
