<UserControl x:Class="GoodMorningFactory.UI.Views.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=vm:ChartOfAccountsViewModel, IsDesignTimeCreatable=True}">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="10" Padding="10" Background="White" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="إضافة" Margin="5" Command="{Binding AddAccountCommand}"/>
                    <Button Content="تعديل" Margin="5" Command="{Binding EditAccountCommand}"/>
                    <Button Content="حذف" Margin="5" Command="{Binding DeleteAccountCommand}"/>
                </StackPanel>

                <TreeView Grid.Row="1" x:Name="AccountsTreeView" ItemsSource="{Binding AccountsTree}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:AccountViewModel}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayName}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="SelectedItemChanged">
                            <i:InvokeCommandAction Command="{Binding SelectedItemChangedCommand}" CommandParameter="{Binding ElementName=AccountsTreeView, Path=SelectedItem}"/>
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </TreeView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="10" Padding="10" Background="White" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding LedgerHeader}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                <DataGrid Grid.Row="1" ItemsSource="{Binding LedgerEntries}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='d'}" Width="Auto"/>
                        <DataGridTextColumn Header="المرجع" Binding="{Binding Reference}" Width="Auto"/>
                        <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="2*"/>
                        <DataGridTextColumn Header="مدين" Binding="{Binding DebitFormatted}" Width="*"/>
                        <DataGridTextColumn Header="دائن" Binding="{Binding CreditFormatted}" Width="*"/>
                        <DataGridTextColumn Header="الرصيد" Binding="{Binding BalanceFormatted}" Width="*" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>