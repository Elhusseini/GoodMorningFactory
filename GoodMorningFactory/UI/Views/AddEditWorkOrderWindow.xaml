<Window x:Class="GoodMorningFactory.UI.Views.AddEditWorkOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="750" Width="900"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditWorkOrderViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="معلومات أمر العمل" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="رقم أمر العمل:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" Background="#EEE" Text="{Binding WorkOrderNumber}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="المنتج المطلوب إنتاجه:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"
                          ItemsSource="{Binding FinishedGoods}" SelectedItem="{Binding SelectedFinishedGood}"
                          IsEnabled="{Binding IsEditingAllowed}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="الكمية المطلوبة:" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding QuantityToProduce}"
                         IsEnabled="{Binding IsEditingAllowed}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="تاريخ البدء المخطط:" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="3" Grid.Column="1" Margin="5" SelectedDate="{Binding PlannedStartDate}" IsEnabled="{Binding IsEditingAllowed}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="تاريخ الانتهاء المخطط:" VerticalAlignment="Center"/>
                <DatePicker Grid.Row="4" Grid.Column="1" Margin="5" SelectedDate="{Binding PlannedEndDate}" IsEnabled="{Binding IsEditingAllowed}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="الحالة:" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="5" Grid.Column="1" Margin="5" IsEnabled="False" Background="#EEE"
                          ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="المواد المطلوبة">
                <DataGrid ItemsSource="{Binding RequiredMaterials}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المادة الخام" Binding="{Binding MaterialName}" Width="2*"/>
                        <DataGridTextColumn Header="الكمية المطلوبة" Binding="{Binding RequiredQuantity, StringFormat=N4}" Width="*"/>
                        <DataGridTextColumn Header="المتوفر بالمخزن" Binding="{Binding AvailableQuantity}" Width="*"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="*" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="المواد المصروفة">
                <DataGrid ItemsSource="{Binding ConsumedMaterials}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المادة الخام" Binding="{Binding MaterialName}" Width="2*"/>
                        <DataGridTextColumn Header="الكمية المصروفة" Binding="{Binding QuantityConsumed, StringFormat=N4}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="التكاليف الفعلية والإغلاق">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="إجمالي تكلفة المواد المصروفة:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActualMaterialCost, StringFormat=N2}" VerticalAlignment="Center"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="إجمالي تكلفة العمالة المسجلة:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualLaborCost, StringFormat=N2}" VerticalAlignment="Center"/>

                    <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="إجمالي التكلفة الفعلية للإنتاج:" FontWeight="Bold" FontSize="14"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalActualCost, StringFormat=N2}" VerticalAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="Blue"/>

                    <Button Grid.Row="4" Grid.Column="1" Content="إغلاق أمر العمل" 
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Padding="15,5" Margin="0,20,0,0"
                            Background="DarkGreen" Foreground="White"
                            Command="{Binding CloseWorkOrderCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <Button Content="💾 حفظ أمر العمل" Padding="15,5" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="▶️ بدء التنفيذ" Margin="10,0,0,0" Padding="10,5" Background="Green" Foreground="White" Command="{Binding StartCommand}"/>
            <Button Content="صرف مواد" Margin="10,0,0,0" Padding="10,5" Background="Orange" Foreground="White" Command="{Binding ConsumeMaterialsCommand}"/>
            <Button Content="تسجيل إنتاج" Margin="10,0,0,0" Padding="10,5" Background="DodgerBlue" Foreground="White" Command="{Binding ReportProductionCommand}"/>
            <Button Content="تسجيل عمالة" Margin="10,0,0,0" Padding="10,5" Background="SaddleBrown" Foreground="White" Command="{Binding RecordLaborCommand}"/>
        </StackPanel>
    </Grid>
</Window>