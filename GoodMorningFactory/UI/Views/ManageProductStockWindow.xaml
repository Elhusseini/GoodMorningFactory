<Window x:Class="GoodMorningFactory.UI.Views.ManageProductStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="500" Width="600"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:ManageProductStockViewModel}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding StockLocations}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="موقع التخزين" Binding="{Binding StorageLocationName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="الكمية الحالية" Binding="{Binding CurrentQuantity}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="الكمية الجديدة" Binding="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="سبب التعديل:"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="حفظ التغييرات" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>