<Window x:Class="GoodMorningFactory.UI.Views.AdjustStockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        Title="جرد وتعديل المخزون" Height="600" Width="900"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:AdjustStockViewModel />
    </Window.DataContext>

    <Window.Resources>
        <converters:NotNullToBooleanConverter x:Key="NotNullToBooleanConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="جرد وتعديل المخزون" Style="{DynamicResource TitleTextBlockStyle}" Grid.Row="0"/>

        <Border Grid.Row="1" Style="{DynamicResource FilterBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="تاريخ التعديل:" Grid.Column="0"/>
                <DatePicker SelectedDate="{Binding AdjustmentDate}" Grid.Column="1" Margin="5"/>

                <Label Content="المخزن الرئيسي:" Grid.Column="2" Margin="10,0,0,0"/>
                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" Grid.Column="3" Margin="5" DisplayMemberPath="Name"/>

                <Label Content="الموقع الفرعي:" Grid.Column="4" Margin="10,0,0,0"/>
                <ComboBox ItemsSource="{Binding Locations}" SelectedItem="{Binding SelectedLocation}" IsEnabled="{Binding SelectedWarehouse, Converter={StaticResource NotNullToBooleanConverter}}" Grid.Column="5" Margin="5" DisplayMemberPath="Name"/>
            </Grid>
        </Border>

        <GroupBox Header="الأصناف المراد جردها" Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Label Content="بحث عن منتج (بالكود أو الاسم):"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="250" IsEnabled="{Binding SelectedLocation, Converter={StaticResource NotNullToBooleanConverter}}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchProductCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ItemsToAdjust}" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود المنتج" Binding="{Binding ProductCode}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="الكمية بالنظام" Binding="{Binding SystemQuantity}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="الكمية الفعلية" Binding="{Binding ActualQuantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="الفرق" Binding="{Binding Difference}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="قيمة الفرق" Binding="{Binding DifferenceValueFormatted}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="ترحيل التعديل" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding PostAdjustmentCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>