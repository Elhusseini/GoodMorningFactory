<Window x:Class="GoodMorningFactory.UI.Views.AddEditSalesQuotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="5" Background="AliceBlue">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="رقم عرض السعر:"/>
                    <TextBox Text="{Binding Quotation.QuotationNumber}" IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="العميل (*):"/>
                    <ComboBox ItemsSource="{Binding Customers}" 
                              SelectedItem="{Binding Quotation.Customer}" 
                              SelectedValue="{Binding Quotation.CustomerId, Mode=TwoWay}"
                              DisplayMemberPath="CustomerName" 
                              SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="قائمة الأسعار:"/>
                    <ComboBox ItemsSource="{Binding PriceLists}" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5">
                    <TextBlock Text="تاريخ العرض:"/>
                    <DatePicker SelectedDate="{Binding Quotation.QuotationDate}"/>
                    <TextBlock Text="صالح حتى تاريخ:"/>
                    <DatePicker SelectedDate="{Binding Quotation.ValidUntilDate}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="بحث عن منتج (بالكود أو الاسم):" VerticalAlignment="Center"/>
                <Button Content="إضافة" DockPanel.Dock="Left" Margin="10,0,0,0" Command="{Binding AddProductCommand}"/>
                <TextBox Text="{Binding SearchProductText, UpdateSourceTrigger=PropertyChanged, Delay=200}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding AddProductCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="3*"/>
                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="الإجمالي الفرعي" Binding="{Binding SubtotalFormatted}" Width="*" IsReadOnly="True"/>
                    <DataGridTemplateColumn Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="حذف" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" Foreground="Red" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#F0F0F0" MinHeight="50">
            <TextBlock Text="الإجمالي:" FontSize="16" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalAmountText}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="Blue"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <Button Content="حفظ" Width="100" Margin="5" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="إلغاء" Width="100" Margin="5" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>