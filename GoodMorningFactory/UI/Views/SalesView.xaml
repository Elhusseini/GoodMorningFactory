<UserControl x:Class="GoodMorningFactory.UI.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:viewmodels="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="WhiteSmoke"
             d:DataContext="{d:DesignInstance Type=viewmodels:SalesViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <!-- محول للتحقق مما إذا كانت الفاتورة المحددة ليست فارغة -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. عنوان الشاشة وشريط الأدوات -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="فواتير المبيعات" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- تم ربط الزر بـ NewSaleCommand في الـ ViewModel -->
            <Button Content="+ فاتورة بيع مباشر" Margin="20,0,0,0" Command="{Binding NewSaleCommand}"/>
            <!-- تم ربط الزر بـ ExportToCsvCommand في الـ ViewModel -->
            <Button Content="📁 تصدير إلى CSV" Margin="10,0,0,0" Command="{Binding ExportToCsvCommand}" Background="#107C10" Foreground="White"/>
        </StackPanel>

        <!-- 2. قسم الفلاتر والبحث -->
        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <WrapPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="بحث (برقم الفاتورة أو العميل):" FontWeight="SemiBold"/>
                    <!-- تم ربط مربع البحث بخاصية SearchText في الـ ViewModel -->
                    <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="العميل:" FontWeight="SemiBold"/>
                    <!-- تم ربط القائمة المنسدلة بخصائص Customers و SelectedCustomer -->
                    <ComboBox Width="150" 
                              ItemsSource="{Binding Customers}" 
                              DisplayMemberPath="CustomerName"
                              SelectedValuePath="Id"
                              SelectedItem="{Binding SelectedCustomer}"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="الحالة:" FontWeight="SemiBold"/>
                    <!-- تم ربط القائمة المنسدلة بخصائص Statuses و SelectedStatus -->
                    <ComboBox Width="120" 
                              ItemsSource="{Binding Statuses}" 
                              SelectedItem="{Binding SelectedStatus}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="تاريخ الاستحقاق من:" FontWeight="SemiBold"/>
                    <!-- تم ربط منتقي التاريخ بـ DueDateFrom -->
                    <DatePicker Width="120" SelectedDate="{Binding DueDateFrom}"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <TextBlock Text="إلى:" FontWeight="SemiBold"/>
                    <!-- تم ربط منتقي التاريخ بـ DueDateTo -->
                    <DatePicker Width="120" SelectedDate="{Binding DueDateTo}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- 3. جدول عرض الفواتير -->
        <!-- تم ربط الجدول بخصائص Sales و SelectedSale في الـ ViewModel -->
        <DataGrid Grid.Row="2" 
                  x:Name="SalesDataGrid"
                  ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True" 
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <!-- لم تتغير أعمدة الجدول، فهي مرتبطة بخصائص SalesItemViewModel -->
                <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="*"/>
                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="2*"/>
                <DataGridTextColumn Header="تاريخ الفاتورة" Binding="{Binding SaleDate, StringFormat='d'}" Width="*"/>
                <DataGridTextColumn Header="تاريخ الاستحقاق" Binding="{Binding DueDate, StringFormat='d'}" Width="*"/>
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmountFormatted}" Width="*" FontWeight="Bold"/>
                <DataGridTextColumn Header="المدفوع" Binding="{Binding AmountPaidFormatted}" Width="*"/>
                <DataGridTextColumn Header="المتبقي" Binding="{Binding BalanceDueFormatted}" Width="*" FontWeight="Bold"/>
                <DataGridTemplateColumn Header="الحالة" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToDescriptionConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- 
                                تم ربط الأزرار داخل الجدول بالأوامر الموجودة في الـ ViewModel الرئيسي.
                                نستخدم RelativeSource للوصول إلى DataContext الخاص بالـ DataGrid (وهو SalesViewModel).
                                نمرر العنصر الحالي (الفاتورة) كـ CommandParameter.
                                -->
                                <Button Content="تسجيل دفعة" Margin="2" 
                                        Command="{Binding DataContext.RecordPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="إنشاء مرتجع" Margin="2" 
                                        Command="{Binding DataContext.CreateReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="طباعة" Margin="2" 
                                        Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="تعديل" Margin="2" 
                                        Command="{Binding DataContext.EditSaleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
