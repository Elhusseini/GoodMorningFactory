<Window x:Class="GoodMorningFactory.UI.Views.AddSalesReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="إنشاء مرتجع مبيعات" Height="600" Width="900"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="معلومات المرتجع" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="مرتجع من فاتورة رقم:"/>
                <!-- تم ربط هذا الحقل بخاصية InvoiceNumber في الـ ViewModel -->
                <TextBlock Grid.Column="1" Text="{Binding InvoiceNumber}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="البنود المرتجعة" Grid.Row="1" Margin="0,10,0,0">
            <!-- تم ربط الجدول بقائمة ItemsToReturn في الـ ViewModel -->
            <DataGrid ItemsSource="{Binding ItemsToReturn}" CanUserAddRows="False" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="الكمية في الفاتورة" Binding="{Binding OriginalQuantity}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="الكمية المرتجعة سابقاً" Binding="{Binding PreviouslyReturnedQuantity}" IsReadOnly="True" Width="*"/>
                    <!-- تم ربط هذا الحقل للسماح للمستخدم بإدخال الكمية المرتجعة -->
                    <DataGridTextColumn Header="الكمية للإرجاع الآن" Binding="{Binding QuantityToReturn, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- تم استبدال حدث Click بربط الأمر ConfirmReturnCommand -->
        <!-- يتم تمرير النافذة نفسها كـ CommandParameter ليتمكن الـ ViewModel من إغلاقها -->
        <Button Content="✅ تأكيد المرتجع" Grid.Row="2" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="15,8" 
                Command="{Binding ConfirmReturnCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>
