<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FlowDocument x:Key="BillOfMaterials" PagePadding="40" ColumnWidth="800" FlowDirection="RightToLeft" FontFamily="Arial" FontSize="12">

        <BlockUIContainer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="CompanyNameTextBlock" FontSize="22" FontWeight="Bold" Foreground="#1A202C"/>
                    <TextBlock x:Name="CompanyAddressTextBlock" Foreground="#4A5568" Margin="0,5,0,0"/>
                    <TextBlock x:Name="CompanyPhoneTextBlock" Foreground="#4A5568"/>
                </StackPanel>
                <Image x:Name="CompanyLogoImage" Grid.Column="1" Width="90" Height="90" Stretch="Uniform"/>
            </Grid>
        </BlockUIContainer>

        <Paragraph TextAlignment="Center" Margin="0,30,0,10">
            <Run Text="قائمة مكونات المنتج" FontSize="26" FontWeight="Bold" Foreground="#1A202C"/>
        </Paragraph>

        <BlockUIContainer>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" CornerRadius="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="المنتج النهائي:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="5,0,20,0" VerticalAlignment="Center"><Run x:Name="ProductNameRun"/></TextBlock>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="كود المنتج:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Margin="5,0,0,0" VerticalAlignment="Center"><Run x:Name="ProductCodeRun"/></TextBlock>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="الوصف:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5,5,0,0" VerticalAlignment="Center"><Run x:Name="DescriptionRun"/></TextBlock>
                </Grid>
            </Border>
        </BlockUIContainer>

        <Table BorderBrush="LightGray" BorderThickness="1" CellSpacing="0" Margin="0,20,0,0">
            <Table.Columns>
                <TableColumn Width="2*"/>
                <TableColumn Width="4*"/>
                <TableColumn Width="*"/>
            </Table.Columns>
            <TableRowGroup>
                <TableRow Background="#EDF2F7" Foreground="#2D3748" FontWeight="Bold">
                    <TableCell>
                        <Paragraph TextAlignment="Center" Padding="8">كود المادة</Paragraph>
                    </TableCell>
                    <TableCell>
                        <Paragraph TextAlignment="Center" Padding="8">اسم المادة الخام</Paragraph>
                    </TableCell>
                    <TableCell>
                        <Paragraph TextAlignment="Center" Padding="8">الكمية المطلوبة</Paragraph>
                    </TableCell>
                </TableRow>
            </TableRowGroup>
            <TableRowGroup x:Name="ItemsTableRowGroup"/>
        </Table>

        <Paragraph TextAlignment="Center" FontSize="11" Margin="0,50,0,0" Foreground="Gray">
            <Run Text="تاريخ الطباعة: "/>
            <Run x:Name="PrintDateRun"/>
            <Span>| نظام مصنع صباح الخير لإدارة الملابس</Span>
        </Paragraph>
    </FlowDocument>
</ResourceDictionary>