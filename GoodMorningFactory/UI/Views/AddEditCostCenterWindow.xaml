<Window x:Class="GoodMorningFactory.UI.Views.AddEditCostCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="300" Width="400"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}" Style="{DynamicResource TitleTextBlockStyle}" Grid.Row="0" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <Label Content="الاسم:"/>
            <TextBox Text="{Binding CostCenter.Name, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="الوصف:" Margin="0,5,0,0"/>
            <TextBox Text="{Binding CostCenter.Description, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox IsChecked="{Binding CostCenter.IsActive}" Content="نشط" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="حفظ" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>