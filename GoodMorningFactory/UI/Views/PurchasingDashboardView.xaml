<UserControl x:Class="GoodMorningFactory.UI.Views.PurchasingDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:viewModels="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="#F5F5F5"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="DashboardCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" Color="#DDD" Opacity="0.5" BlurRadius="10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashboardSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="36"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModels:PurchasingDashboardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="لوحة معلومات المشتريات" Grid.Row="0" FontSize="32" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="قيمة أوامر الشراء المفتوحة" Style="{StaticResource CardTitleStyle}"/>
                    <!-- هنا سيتم استخدام YFormatter الخاص بالـ ViewModel لتنسيق العملة -->
                    <TextBlock Text="{Binding TotalOpenPOValue, StringFormat={}{0:N2}}" Style="{StaticResource CardValueStyle}" Foreground="#007ACC"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="فواتير تستحق قريباً" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding InvoicesDueSoonCount}" Style="{StaticResource CardValueStyle}" Foreground="#E67E22"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource DashboardCardStyle}">
                <StackPanel>
                    <TextBlock Text="طلبات شراء معلقة" Style="{StaticResource CardTitleStyle}"/>
                    <TextBlock Text="{Binding PendingRequisitionsCount}" Style="{StaticResource CardValueStyle}" Foreground="#27AE60"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Chart Section -->
            <Border Grid.Column="0" Style="{StaticResource DashboardSectionStyle}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="المشتريات خلال آخر 6 أشهر" FontSize="18" FontWeight="SemiBold" Foreground="#444" Margin="10"/>

                    <lvc:CartesianChart Grid.Row="1" Series="{Binding Series}" LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="الشهر" Labels="{Binding Labels}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="إجمالي المشتريات" LabelFormatter="{Binding YFormatter}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>

                </Grid>
            </Border>

            <!-- Recent Activity Section -->
            <Border Grid.Column="1" Style="{StaticResource DashboardSectionStyle}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="آخر أوامر الشراء" FontSize="18" FontWeight="SemiBold" Foreground="#444" Margin="10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding RecentPurchaseOrders}"
                              AutoGenerateColumns="False" IsReadOnly="True" Background="White"
                              BorderThickness="0" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الأمر" Binding="{Binding DocumentNumber}" Width="*"/>
                            <DataGridTextColumn Header="المورد" Binding="{Binding SupplierName}" Width="*"/>
                            <!-- استخدام TotalAmountFormatted لعرض العملة -->
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmountFormatted}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>