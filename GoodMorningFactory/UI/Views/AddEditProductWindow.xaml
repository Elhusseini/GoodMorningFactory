<Window x:Class="GoodMorningFactory.UI.Views.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="800"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditProductViewModel, IsDesignTimeCreatable=True}">

	<Window.Resources>
		<converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TabControl Grid.Row="0" Margin="10">
			<TabItem Header="معلومات أساسية">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="200"/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Column="0" Margin="10">
							<TextBlock Text="كود المنتج (*):"/>
							<TextBox Text="{Binding ProductCode}" IsReadOnly="True" Background="#EEE"/>
							<TextBlock Text="اسم المنتج (*):"/>
							<TextBox Text="{Binding Name}"/>
							<TextBlock Text="الوصف:"/>
							<TextBox Text="{Binding Description}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
							<TextBlock Text="نوع المنتج (*):"/>
							<ComboBox ItemsSource="{Binding ProductTypes}" SelectedItem="{Binding ProductType}">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<TextBlock Text="فئة المنتج (*):"/>
							<ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name"/>
							<TextBlock Text="باركود:"/>
							<TextBox Text="{Binding Barcode}"/>
							<CheckBox IsChecked="{Binding IsActive}" Content="المنتج نشط"/>
						</StackPanel>
						<StackPanel Grid.Column="1" Margin="10,10,20,10">
							<Border BorderBrush="Gray" BorderThickness="1" Height="150" Width="150" Margin="0,0,0,10">
								<Image Source="{Binding ProductImage}" Stretch="Uniform"/>
							</Border>
							<Button Content="رفع صورة" Command="{Binding UploadImageCommand}"/>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="التسعير والتكلفة">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="10">
						<TextBlock Text="سعر الشراء:"/>
						<TextBox Text="{Binding PurchasePrice}"/>
						<TextBlock Text="سعر البيع:"/>
						<TextBox Text="{Binding SalePrice}"/>
						<TextBlock Text="العملة (*):"/>
						<ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding SelectedCurrency}" DisplayMemberPath="Name"/>
						<TextBlock Text="قاعدة الضريبة المطبقة:"/>
						<ComboBox ItemsSource="{Binding TaxRules}" SelectedItem="{Binding SelectedTaxRule}" DisplayMemberPath="Name"/>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="المخزون والتوريد">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="10">
						<CheckBox IsChecked="{Binding TrackInventory}" Content="تتبع المخزون لهذا المنتج"/>
						<StackPanel Visibility="{Binding InventoryFieldsVisibility}">
							<TextBlock Text="موقع التخزين الأساسي (*):" Margin="0,5,0,0"/>
							<ComboBox ItemsSource="{Binding StorageLocations}" SelectedItem="{Binding SelectedPrimaryLocation}" DisplayMemberPath="Name"/>
							<TextBlock Text="وحدة القياس:"/>
							<ComboBox ItemsSource="{Binding UnitsOfMeasure}" SelectedItem="{Binding SelectedUnitOfMeasure}" DisplayMemberPath="Name"/>
							<TextBlock Text="حد إعادة الطلب:"/>
							<TextBox Text="{Binding ReorderLevel}"/>
							<TextBlock Text="الحد الأدنى للمخزون:"/>
							<TextBox Text="{Binding MinStockLevel}"/>
							<TextBlock Text="الحد الأقصى للمخزون:"/>
							<TextBox Text="{Binding MaxStockLevel}"/>
							<TextBlock Text="المورد الافتراضي:"/>
							<ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedDefaultSupplier}" DisplayMemberPath="Name"/>
							<TextBlock Text="مدة التوريد (بالأيام):"/>
							<TextBox Text="{Binding LeadTimeDays}"/>
							<Label Content="طريقة التتبع:" FontWeight="Bold" Margin="0,15,0,0"/>
							<ComboBox ItemsSource="{Binding TrackingMethods}" SelectedItem="{Binding TrackingMethod}">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabItem>
			<TabItem Header="نسخ من منتج آخر">
				<StackPanel Margin="15">
					<TextBlock Text="يمكنك هنا نسخ البيانات من منتج موجود لتسريع عملية الإدخال." TextWrapping="Wrap" Margin="0,0,0,20"/>
					<TextBlock Text="ابحث عن المنتج المراد نسخ بياناته:"/>
					<ComboBox IsEditable="True" StaysOpenOnEdit="True"
                              ItemsSource="{Binding SearchableProducts}"
                              SelectedItem="{Binding SelectedProductToCopy}"
                              DisplayMemberPath="Name"
                              Text="{Binding CopySearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
					<Button Content="نسخ البيانات" Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding CopyDataCommand}"/>
				</StackPanel>
			</TabItem>
		</TabControl>

		<Border Grid.Row="1" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="0,1,0,0">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
				<Button Content="حفظ" Width="100" Margin="5" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
				<Button Content="إلغاء" Width="100" Margin="5" IsCancel="True"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>