<Window x:Class="GoodMorningFactory.UI.Views.AddEditAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditAccountViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="15">
            <TextBlock Text="رقم الحساب (*):"/>
            <TextBox Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="اسم الحساب (*):"/>
            <TextBox Text="{Binding AccountName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <TextBlock Text="نوع الحساب (*):"/>
            <ComboBox ItemsSource="{Binding AccountTypes}" 
                      SelectedItem="{Binding SelectedAccountType}" 
                      Margin="0,0,0,10">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="الحساب الأب (اختياري):"/>
            <ComboBox ItemsSource="{Binding ParentAccounts}" 
                      SelectedItem="{Binding SelectedParentAccount}"
                      DisplayMemberPath="AccountName"
                      Margin="0,0,0,10"/>

            <CheckBox IsChecked="{Binding IsBank}" Content="هذا حساب بنكي (للتسويات البنكية)" Margin="0,10,0,0"/>
            <CheckBox IsChecked="{Binding IsActive}" Content="الحساب نشط" Margin="0,10,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="LightGray" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                <Button Content="حفظ" Width="100" Margin="5" IsDefault="True" 
                        Command="{Binding SaveCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Content="إلغاء" Width="100" Margin="5" IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>