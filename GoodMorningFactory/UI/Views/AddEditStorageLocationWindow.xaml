<Window x:Class="GoodMorningFactory.UI.Views.AddEditStorageLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="إضافة/تعديل موقع تخزين" Height="380" Width="450"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:AddEditStorageLocationViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{DynamicResource TitleTextBlockStyle}" Grid.Row="0"/>

        <StackPanel Grid.Row="1">
            <Label Content="كود الموقع (*):"/>
            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="اسم الموقع (*):"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Content="الوصف:"/>
            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

            <CheckBox IsChecked="{Binding IsActive}" Content="نشط" Margin="0,10,0,0"/>
            <CheckBox IsChecked="{Binding IsDefault}" Content="اجعله الموقع الافتراضي لاستلام الإنتاج" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="حفظ" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>