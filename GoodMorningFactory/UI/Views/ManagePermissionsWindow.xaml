<Window x:Class="GoodMorningFactory.UI.Views.ManagePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        Title="إدارة الصلاحيات" Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        d:DataContext="{d:DesignInstance Type=vm:ManagePermissionsViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <!-- *** بداية الإصلاح: إضافة المحول المفقود *** -->
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Text="{Binding RoleNameText}"/>

        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1">
            <!-- *** بداية الإصلاح: ربط خاصية IsEnabled بشكل صحيح *** -->
            <TreeView ItemsSource="{Binding PermissionGroups}" IsEnabled="{Binding IsEditingEnabled}">
                <!-- *** نهاية الإصلاح *** -->
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:PermissionGroupViewModel}" ItemsSource="{Binding Permissions}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsAllSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ModuleName}" FontWeight="Bold" FontSize="14" Margin="5,0"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PermissionViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="20,5,0,5">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Description}" Margin="5,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" Background="#F5F5F5" CornerRadius="5" Visibility="{Binding ControlsVisibility}">
            <StackPanel Orientation="Horizontal">
                <Label Content="نسخ الصلاحيات من دور:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Width="150" Margin="5,0" ItemsSource="{Binding RolesForCopy}" SelectedItem="{Binding SelectedRoleToCopy}" DisplayMemberPath="Name"/>
                <Button Content="نسخ الآن" Command="{Binding CopyCommand}" Padding="10,5" Margin="5,0" Background="#17A2B8" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
            <Button Content="حفظ الصلاحيات" Click="SavePermissions_Click" Padding="15,8" Background="#28A745" Foreground="White" BorderThickness="0" Visibility="{Binding ControlsVisibility}"/>
            <Button Content="{Binding CancelButtonText}" IsCancel="True" Padding="15,8" Margin="10,0,0,0" Background="#6C757D" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
