<!-- GoodMorning/UI/Views/CustomerStatementTemplate.xaml -->
<!-- تم إعادة تصميم هذا القالب بالكامل ليطابق الشكل الجذاب لقالب فاتورة المبيعات -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FlowDocument x:Key="CustomerStatement" PagePadding="40" ColumnWidth="800" FlowDirection="RightToLeft" FontFamily="Arial" FontSize="13">
        <!-- 1. الترويسة وبيانات الشركة -->
        <Table>
            <Table.Columns>
                <TableColumn Width="3*"/>
                <TableColumn Width="1.2*"/>
            </Table.Columns>
            <TableRowGroup>
                <TableRow>
                    <TableCell>
                        <Paragraph FontSize="26" FontWeight="Bold" Foreground="#2a4d7a">
                            <Run x:Name="CompanyNameRun">اسم الشركة</Run>
                        </Paragraph>
                        <Paragraph>
                            <Run x:Name="CompanyAddressRun">عنوان الشركة</Run>
                        </Paragraph>
                        <Paragraph>
                            <Run x:Name="CompanyPhoneRun">هاتف الشركة</Run>
                        </Paragraph>
                    </TableCell>
                    <TableCell>
                        <BlockUIContainer>
                            <Border BorderBrush="#2a4d7a" BorderThickness="1" CornerRadius="8" Padding="4">
                                <Image x:Name="CompanyLogoImage" Height="80" HorizontalAlignment="Center"/>
                            </Border>
                        </BlockUIContainer>
                    </TableCell>
                </TableRow>
            </TableRowGroup>
        </Table>

        <!-- 2. عنوان التقرير -->
        <Paragraph TextAlignment="Center" Margin="0,20,0,0">
            <Run Text="كشف حساب العميل" FontSize="22" FontWeight="Bold" Foreground="#2a4d7a"/>
        </Paragraph>

        <!-- 3. بيانات العميل وتاريخ التقرير -->
        <Table Margin="0,20,0,10">
            <Table.Columns>
                <TableColumn Width="*"/>
                <TableColumn Width="*"/>
            </Table.Columns>
            <TableRowGroup>
                <TableRow>
                    <TableCell>
                        <Paragraph FontWeight="Bold">معلومات العميل:</Paragraph>
                        <Paragraph>
                            <Run Text="اسم العميل: "/>
                            <Run x:Name="CustomerNameRun" FontWeight="Bold"/>
                        </Paragraph>
                        <Paragraph>
                            <Run Text="العنوان: "/>
                            <Run x:Name="CustomerAddressRun"/>
                        </Paragraph>
                    </TableCell>
                    <TableCell>
                        <Paragraph TextAlignment="Left">
                            <Run Text="تاريخ التقرير: "/>
                            <Run x:Name="ReportDateRun" FontWeight="Bold"/>
                        </Paragraph>
                    </TableCell>
                </TableRow>
            </TableRowGroup>
        </Table>

        <!-- 4. جدول الحركات المالية -->
        <Table CellSpacing="0" BorderBrush="#2a4d7a" BorderThickness="1" Margin="0,10,0,0">
            <Table.Columns>
                <TableColumn Width="*"/>
                <TableColumn Width="1.5*"/>
                <TableColumn Width="*"/>
                <TableColumn Width="*"/>
                <TableColumn Width="*"/>
                <TableColumn Width="1.2*"/>
            </Table.Columns>
            <TableRowGroup x:Name="ItemsTableRowGroup">
                <TableRow Background="#e3eaf6" FontWeight="Bold">
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,1,1" Padding="4" TextAlignment="Center">
                        <Paragraph>التاريخ</Paragraph>
                    </TableCell>
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,1,1" Padding="4" TextAlignment="Center">
                        <Paragraph>نوع الحركة</Paragraph>
                    </TableCell>
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,1,1" Padding="4" TextAlignment="Center">
                        <Paragraph>المرجع</Paragraph>
                    </TableCell>
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,1,1" Padding="4" TextAlignment="Center">
                        <Paragraph>مدين</Paragraph>
                    </TableCell>
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,1,1" Padding="4" TextAlignment="Center">
                        <Paragraph>دائن</Paragraph>
                    </TableCell>
                    <TableCell BorderBrush="#2a4d7a" BorderThickness="0,0,0,1" Padding="4" TextAlignment="Center">
                        <Paragraph>الرصيد</Paragraph>
                    </TableCell>
                </TableRow>
                <!-- سيتم إضافة الصفوف هنا من الكود -->
            </TableRowGroup>
        </Table>

        <!-- 5. جدول الملخص النهائي -->
        <Table Margin="0,20,0,0">
            <Table.Columns>
                <TableColumn Width="3*"/>
                <TableColumn Width="2*"/>
            </Table.Columns>
            <TableRowGroup>
                <TableRow>
                    <TableCell/>
                    <TableCell>
                        <Table CellSpacing="0" BorderBrush="#2a4d7a" BorderThickness="1">
                            <Table.Columns>
                                <TableColumn Width="*"/>
                                <TableColumn Width="*"/>
                            </Table.Columns>
                            <TableRowGroup>
                                <TableRow>
                                    <TableCell Padding="4">
                                        <Paragraph>إجمالي مدين:</Paragraph>
                                    </TableCell>
                                    <TableCell Padding="4">
                                        <Paragraph TextAlignment="Left">
                                            <Run x:Name="TotalDebitRun"/>
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow>
                                    <TableCell Padding="4">
                                        <Paragraph>إجمالي دائن:</Paragraph>
                                    </TableCell>
                                    <TableCell Padding="4">
                                        <Paragraph TextAlignment="Left">
                                            <Run x:Name="TotalCreditRun"/>
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                                <TableRow FontWeight="Bold" Background="#e3eaf6">
                                    <TableCell Padding="4">
                                        <Paragraph>الرصيد النهائي:</Paragraph>
                                    </TableCell>
                                    <TableCell Padding="4">
                                        <Paragraph TextAlignment="Left">
                                            <Run x:Name="FinalBalanceRun"/>
                                        </Paragraph>
                                    </TableCell>
                                </TableRow>
                            </TableRowGroup>
                        </Table>
                    </TableCell>
                </TableRow>
            </TableRowGroup>
        </Table>

        <!-- 6. التذييل -->
        <Paragraph TextAlignment="Center" FontSize="11" Margin="0,40,0,0" Foreground="#2a4d7a">
            <Run Text="شكراً لتعاملكم معنا"/>
        </Paragraph>
    </FlowDocument>

</ResourceDictionary>
