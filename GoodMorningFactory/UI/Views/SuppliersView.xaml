<!-- GoodMorningFactory/UI/Views/SuppliersView.xaml -->
<UserControl x:Class="GoodMorningFactory.UI.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             xmlns:s="clr-namespace:GoodMorningFactory.Core.Services"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="#F5F5F5"
             d:DataContext="{d:DesignInstance Type=vm:SuppliersViewViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="إدارة الموردين" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="➕ إضافة مورد جديد" Margin="20,0,0,0" Command="{Binding AddSupplierCommand}"/>
            <Button Content="📁 تصدير إلى CSV" Margin="10,0,0,0" Command="{Binding ExportToCsvCommand}" Background="#107C10" Foreground="White"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,10" BorderBrush="#DDD" BorderThickness="1">
            <ToolBarTray>
                <ToolBar>
                    <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                    <TextBox Width="250" VerticalContentAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                    <Separator Margin="10,0"/>
                    <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                    <ComboBox Width="120" 
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Name"/>
                </ToolBar>
            </ToolBarTray>
        </Border>

        <DataGrid Grid.Row="2" Margin="0,10,0,0"
                  ItemsSource="{Binding Suppliers}"
                  IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="كود المورد" Binding="{Binding SupplierCode}" Width="*"/>
                <DataGridTextColumn Header="اسم المورد" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="شخص الاتصال" Binding="{Binding ContactPerson}" Width="*"/>
                <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding PhoneNumber}" Width="*"/>
                <DataGridTemplateColumn Header="الرصيد الحالي" Width="*" SortMemberPath="CurrentBalance">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" HorizontalAlignment="Right" Margin="4,0,4,0">
                                <Run Text="{Binding CurrentBalance, StringFormat=N2}"/>
                                <Run Text=" "/>
                                <!-- *** بداية التصحيح: تم إرجاع الطريقة الأصلية والآمنة *** -->
                                <Run Text="{x:Static s:AppSettings.DefaultCurrencySymbol}" />
                                <!-- *** نهاية التصحيح *** -->
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="الحالة" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"
                                       Foreground="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                                       FontWeight="Bold" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Margin="2" Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
                                <Button Content="عرض كشف حساب" Margin="2" Command="{Binding DataContext.ViewStatementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightBlue"/>
                                <Button Content="حذف" Margin="2" Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="LightCoral"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="5" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" HorizontalAlignment="Left" Content="&lt; السابق" Command="{Binding PreviousPageCommand}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding PageInfo}"/>
                <Button Grid.Column="2" HorizontalAlignment="Right" Content="التالي &gt;" Command="{Binding NextPageCommand}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
