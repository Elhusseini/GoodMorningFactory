<UserControl x:Class="GoodMorningFactory.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewViewModel, IsDesignTimeCreatable=True}">

    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter"/>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="إدارة المستخدمين" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="إضافة مستخدم جديد" Command="{Binding AddUserCommand}" MinWidth="120"/>
                <TextBlock Text="بحث:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <TextBox Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                <TextBlock Text="الحالة:" VerticalAlignment="Center" Margin="20,0,5,0"/>
                <ComboBox Width="120" 
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          DisplayMemberPath="Name"/>
                <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" Margin="20,0,5,0"/>
            </StackPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Users}" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="الصورة" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="40" Height="40" Margin="5">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ProfilePicture}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="1.5*"/>
                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="2*"/>
                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="2*"/>
                <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="*"/>
                <DataGridTextColumn Header="القسم" Binding="{Binding DepartmentName}" Width="*"/>
                <DataGridTemplateColumn Header="الحالة" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="تاريخ الإنشاء" Binding="{Binding CreatedAt, StringFormat='yyyy/MM/dd'}" Width="*"/>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="تعديل" Padding="8,3" Margin="2" Background="#FFC107"
                                        Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="عرض الصلاحيات" Padding="8,3" Margin="2" Background="#17A2B8"
                                        Command="{Binding DataContext.ViewPermissionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="تغيير الحالة" Padding="8,3" Margin="2" Background="#6C757D"
                                        Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="&lt; السابق" Command="{Binding PreviousPageCommand}"/>
            <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
            <Button Content="التالي &gt;" Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
