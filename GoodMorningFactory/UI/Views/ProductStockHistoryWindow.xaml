<Window x:Class="GoodMorningFactory.UI.Views.ProductStockHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d" Title="سجل حركات المنتج" Height="500" Width="800"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">

    <Window.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding ProductNameText}" Grid.Row="0" FontSize="18" FontWeight="Bold" Margin="5"/>

        <DataGrid ItemsSource="{Binding History}" Grid.Row="1" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding Date, StringFormat='yyyy/MM/dd hh:mm tt'}" Width="1.5*"/>
                <DataGridTextColumn Header="نوع الحركة" Binding="{Binding MovementType, Converter={StaticResource EnumToDescriptionConverter}}" Width="1.5*"/>
                <DataGridTextColumn Header="رقم المرجع" Binding="{Binding ReferenceNumber}" Width="1.5*"/>
                <DataGridTextColumn Header="كمية داخلة" Binding="{Binding QuantityIn}" Width="*"/>
                <DataGridTextColumn Header="كمية خارجة" Binding="{Binding QuantityOut}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>