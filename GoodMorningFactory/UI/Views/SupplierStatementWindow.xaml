<!-- GoodMorningFactory/UI/Views/SupplierStatementWindow.xaml -->
<Window x:Class="GoodMorningFactory.UI.Views.SupplierStatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="كشف حساب المورد" Height="600" Width="800"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:SupplierStatementViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding SupplierName}" FontSize="18" FontWeight="Bold" Margin="5"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding StatementItems}" Margin="0,10,0,0" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="التاريخ" Binding="{Binding Date, StringFormat='yyyy/MM/dd'}" Width="*"/>
                <DataGridTextColumn Header="نوع الحركة" Binding="{Binding TransactionType}" Width="*"/>
                <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceNumber}" Width="*"/>
                <DataGridTextColumn Header="مدين (لنا)" Binding="{Binding Debit, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="دائن (لهم)" Binding="{Binding Credit, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="*" FontWeight="Bold"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
