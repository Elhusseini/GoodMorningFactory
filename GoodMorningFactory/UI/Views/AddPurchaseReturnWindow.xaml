<Window x:Class="GoodMorningFactory.UI.Views.AddPurchaseReturnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        Title="إضافة مرتجع مشتريات" Height="600" Width="800"
        d:DataContext="{d:DesignInstance Type=vm:AddPurchaseReturnViewModel}"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="إضافة مرتجع مشتريات" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                    Visibility="{Binding IsPurchaseSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="الرجاء اختيار فاتورة الشراء الأصلية:" FontSize="16" Margin="0,0,0,10"/>
            <ComboBox ItemsSource="{Binding AvailablePurchases}" SelectedItem="{Binding SelectedPurchase}" DisplayMemberPath="InvoiceNumber" Width="300" Height="30"/>
            <Button Content="اختيار الفاتورة" Command="{Binding SelectPurchaseCommand}" Margin="0,15,0,0" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Visibility="{Binding IsPurchaseSelectionVisible, ConverterParameter=invert, Converter={StaticResource BooleanToVisibilityConverter}}">
            <GroupBox Header="معلومات الفاتورة الأصلية" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Grid.Column="0" Content="رقم الفاتورة:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InvoiceNumberText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Label Grid.Row="0" Grid.Column="2" Content="المورد:"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SupplierNameText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Label Grid.Row="1" Grid.Column="0" Content="تاريخ الفاتورة:"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InvoiceDateText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox>

            <TextBlock Text="الأصناف المراد إرجاعها" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <DataGrid ItemsSource="{Binding ItemsToReturn}" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="الكمية المشتراة" Binding="{Binding OriginalQuantity}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="الكمية المرتجعة" Binding="{Binding QuantityToReturn, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <Button Grid.Row="2" Content="تأكيد الإرجاع" Command="{Binding ConfirmReturnCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
    </Grid>
</Window>