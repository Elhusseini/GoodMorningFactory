<Window x:Class="GoodMorningFactory.UI.Views.AddEditOpportunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة / تعديل فرصة بيعية" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <StackPanel Margin="15">
        <Label Content="اسم الفرصة (*):"/>
        <TextBox Text="{Binding Opportunity.Name, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Content="العميل (*):"/>
        <ComboBox ItemsSource="{Binding Customers}" 
                  SelectedItem="{Binding Opportunity.Customer}"
                  SelectedValue="{Binding Opportunity.CustomerId, Mode=TwoWay}"
                  DisplayMemberPath="CustomerName" 
                  SelectedValuePath="Id"/>

        <Label Content="القيمة التقديرية:"/>
        <TextBox Text="{Binding Opportunity.EstimatedValue, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Content="تاريخ الإغلاق المتوقع:"/>
        <DatePicker SelectedDate="{Binding Opportunity.CloseDate, Mode=TwoWay}"/>

        <Label Content="المرحلة (*):"/>
        <ComboBox ItemsSource="{Binding Stages}" 
                  SelectedValue="{Binding Opportunity.Stage, Mode=TwoWay}"
                  DisplayMemberPath="Description" 
                  SelectedValuePath="Value"/>

        <Label Content="الموظف المسؤول:"/>
        <ComboBox ItemsSource="{Binding Users}" 
                  SelectedItem="{Binding Opportunity.AssignedToUser}"
                  SelectedValue="{Binding Opportunity.AssignedToUserId, Mode=TwoWay}"
                  DisplayMemberPath="Username" 
                  SelectedValuePath="Id"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="حفظ" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>