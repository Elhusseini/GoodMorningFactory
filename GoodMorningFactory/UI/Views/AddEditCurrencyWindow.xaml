<Window x:Class="GoodMorningFactory.UI.Views.AddEditCurrencyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">

    <StackPanel Margin="20">
        <Label Content="اسم العملة (*):"/>
        <TextBox Text="{Binding Currency.Name, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <Label Content="الرمز (Symbol) (*):"/>
        <TextBox Text="{Binding Currency.Symbol, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <Label Content="الكود (Code) (*):"/>
        <TextBox Text="{Binding Currency.Code, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

        <Label Content="اسم العملة بالعربية (للطباعة والتفقيط):"/>
        <TextBox Text="{Binding Currency.CurrencyName_AR, UpdateSourceTrigger=PropertyChanged}" Margin="5" ToolTip="مثال: ريال سعودي"/>

        <Label Content="اسم الكسر بالعربية (للطباعة والتفقيط):"/>
        <TextBox Text="{Binding Currency.FractionalUnit_AR, UpdateSourceTrigger=PropertyChanged}" Margin="5" ToolTip="مثال: هللة"/>

        <CheckBox IsChecked="{Binding Currency.IsActive}" Content="نشط" Margin="5"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="حفظ" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="100"/>
            <Button Content="إلغاء" IsCancel="True" Width="100" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>