<UserControl x:Class="GoodMorningFactory.UI.Views.GoodsReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5" FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:GoodsReceiptsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Content="🔄 تحديث" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="5,0,0,10"/>

        <DataGrid ItemsSource="{Binding GoodsReceipts}" Grid.Row="1" Margin="5" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم السند" Binding="{Binding GRNNumber}" Width="*"/>
                <DataGridTextColumn Header="أمر الشراء" Binding="{Binding PurchaseOrder.PurchaseOrderNumber}" Width="*"/>
                <DataGridTextColumn Header="المورد" Binding="{Binding PurchaseOrder.Supplier.Name}" Width="2*"/>
                <DataGridTextColumn Header="تاريخ الاستلام" Binding="{Binding ReceiptDate, StringFormat='d'}" Width="*"/>

                <DataGridCheckBoxColumn Header="تمت الفوترة؟" Binding="{Binding IsInvoiced, Mode=OneWay}" IsReadOnly="True" Width="Auto"/>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="عرض التفاصيل" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" Background="Gray"/>
                                <Button Content="إنشاء فاتورة" Command="{Binding DataContext.CreateInvoiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" Background="DodgerBlue"/>
                                <Button Content="طباعة" Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ActionButtonStyle}" Background="LightSlateGray"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="LightGray" Padding="5" Margin="0,5,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&lt; السابق" Command="{Binding PreviousPageCommand}" Margin="5,0"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Content="التالي &gt;" Command="{Binding NextPageCommand}" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>