<Window x:Class="GoodMorningFactory.UI.Views.RecordLaborWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="تسجيل وقت العمالة" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:RecordLaborViewModel}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="أمر العمل:" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="5" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding WorkOrderNumber}"/>

        <Label Grid.Row="1" Grid.Column="0" Content="الموظف:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" DisplayMemberPath="FirstName" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"/>

        <Label Grid.Row="2" Grid.Column="0" Content="تاريخ العمل:" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="5" SelectedDate="{Binding WorkDate}"/>

        <Label Grid.Row="3" Grid.Column="0" Content="عدد الساعات:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="5" Text="{Binding HoursWorked, UpdateSourceTrigger=PropertyChanged}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="وصف:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="5" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>

        <Button Grid.Row="5" Grid.Column="1" Content="💾 حفظ" HorizontalAlignment="Left" Padding="15,5" Margin="5" 
                Command="{Binding SaveCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Grid>
</Window>