<Window x:Class="GoodMorningFactory.UI.Views.AddEditSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="1100"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="معلومات الفاتورة" Grid.Row="0" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="العميل (*):"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Margin="5" DisplayMemberPath="CustomerName"/>
                <Label Grid.Column="2" Content="التاريخ:"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding SaleDate}" Margin="5"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="بنود الفاتورة" Grid.Row="1" Margin="10,0,10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="بحث عن منتج:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox Text="{Binding SearchProductText, UpdateSourceTrigger=PropertyChanged}" Width="300">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Items}" Grid.Row="1" Margin="5" CanUserAddRows="False" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="3*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding SubtotalFormatted}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="❌" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="Red"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <TextBlock Text="الإجمالي:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalAmountText}" FontSize="16" FontWeight="Bold" Foreground="Blue" Margin="10,0,20,0" VerticalAlignment="Center"/>
            <TextBlock Text="المبلغ المدفوع:" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox Text="{Binding AmountPaid, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="5,0,20,0" VerticalAlignment="Center"/>
            <Button Content="💾 حفظ" Width="120" Margin="20,0,5,0" Padding="8" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Width="100" Margin="5" Padding="8" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>