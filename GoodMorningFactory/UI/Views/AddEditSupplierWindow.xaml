<!-- GoodMorningFactory/UI/Views/AddEditSupplierWindow.xaml -->
<Window x:Class="GoodMorningFactory.UI.Views.AddEditSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditSupplierViewModel}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="معلومات عامة">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Content="كود المورد:"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SupplierCode}" IsReadOnly="True" Background="#EEEEEE"/>
                    <Label Grid.Row="1" Content="اسم المورد:"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <Label Grid.Row="2" Content="شخص الاتصال:"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="3" Content="رقم الهاتف:"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="4" Content="البريد الإلكتروني:"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                    <Label Grid.Row="5" Content="الموقع الإلكتروني:"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Grid.Row="6" Content="الحالة:"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" Content="نشط" VerticalAlignment="Center" IsChecked="{Binding IsActive}"/>
                </Grid>
            </TabItem>
            <TabItem Header="العناوين والشروط">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <GroupBox Header="العنوان" Grid.Row="0">
                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </GroupBox>
                    <Label Grid.Row="1" Content="شروط الدفع:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Margin="90,5,5,5" Text="{Binding DefaultPaymentTerms, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="💾 حفظ" Width="100" IsDefault="True" Click="SaveButton_Click"/>
            <Button Content="إلغاء" Width="100" Margin="5,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
