<Window x:Class="GoodMorningFactory.UI.Views.AddShipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="إنشاء شحنة جديدة" Height="600" Width="950"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:AddShipmentViewModel, IsDesignTimeCreatable=True}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="إنشاء شحنة جديدة" FontSize="20" FontWeight="Bold" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="5">
                <Label Content="رقم أمر البيع:"/>
                <TextBox Text="{Binding SalesOrderNumber}" IsReadOnly="True"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5">
                <Label Content="تاريخ الشحن:"/>
                <DatePicker SelectedDate="{Binding ShipmentDate}"/>
            </StackPanel>
        </Grid>

        <DataGrid ItemsSource="{Binding ItemsToShip}" Grid.Row="2" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                <DataGridTextColumn Header="الكمية المطلوبة" Binding="{Binding OrderedQuantity}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="تم شحنه سابقاً" Binding="{Binding PreviouslyShippedQuantity}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="الكمية المراد شحنها" Binding="{Binding QuantityToShip, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTemplateColumn Header="صرف من الموقع" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableLocations}" 
                                      DisplayMemberPath="DisplayName" 
                                      SelectedValuePath="StorageLocationId" 
                                      SelectedValue="{Binding SourceLocationId, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="بيانات التتبع" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="اختيار الأرقام" 
                                    Command="{Binding DataContext.SelectTrackingDataCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsTracked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="تأكيد الشحن والفوترة" Command="{Binding ConfirmShipmentCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
