<UserControl x:Class="GoodMorningFactory.UI.Views.JournalVouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5" FlowDirection="RightToLeft"
             d:DataContext="{d:DesignInstance Type=vm:JournalVouchersViewModel, IsDesignTimeCreatable=True}">
    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button Content="➕ إضافة قيد يومي جديد" Command="{Binding AddVoucherCommand}" HorizontalAlignment="Left" Margin="5" Padding="10,5"/>
            <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="5" Padding="10,5"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Vouchers}" Grid.Row="1" Margin="5" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="رقم القيد" Binding="{Binding VoucherNumber}" Width="*"/>
                <DataGridTextColumn Header="تاريخ القيد" Binding="{Binding VoucherDate, StringFormat='d'}" Width="*"/>
                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="3*"/>
                <DataGridTextColumn Header="إجمالي المدين" Binding="{Binding TotalDebitFormatted}" Width="*"/>
                <DataGridTextColumn Header="إجمالي الدائن" Binding="{Binding TotalCreditFormatted}" Width="*"/>
                <DataGridTemplateColumn Header="الحالة" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToDescriptionConverter}}" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="عكس القيد" Margin="2" 
                                        Command="{Binding DataContext.ReverseVoucherCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"
                                        Background="IndianRed" Foreground="White"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
