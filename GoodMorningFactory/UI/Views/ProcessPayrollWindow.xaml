<Window x:Class="GoodMorningFactory.UI.Views.ProcessPayrollWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:local="clr-namespace:GoodMorningFactory.UI.Converters"  
        mc:Ignorable="d"
        Title="معالجة مسير رواتب جديد" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:ProcessPayrollViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <ResourceDictionary>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Label Content="معالجة رواتب شهر:"/>
            <ComboBox Width="100" ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}"/>
            <Label Content="سنة:"/>
            <ComboBox Width="80" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}"/>
            <Button Content="🔍 احتساب" Margin="10,0" Padding="10,2" Command="{Binding CalculatePayrollCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Payslips}" Grid.Row="1" Margin="0,10,0,0" CanUserAddRows="False" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="2*"/>
                <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding BasicSalary, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="إجمالي البدلات" Binding="{Binding Allowances, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="أيام إجازة (غير مدفوعة)" Binding="{Binding UnpaidLeaveDays, StringFormat=N1}" Width="*"/>
                <DataGridTextColumn Header="أيام غياب (خصم)" Binding="{Binding AbsenceDays, StringFormat=N1}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="LightSalmon" />
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="الخصومات" Binding="{Binding Deductions, StringFormat=N2}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="MistyRose" />
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="صافي الراتب" Binding="{Binding NetSalary, StringFormat=N2}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="LightGreen" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="TextAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="💾 حفظ واعتماد المسير" Grid.Row="2" HorizontalAlignment="Left" Padding="15,5" Margin="5" Command="{Binding ConfirmPayrollCommand}" Click="ConfirmButton_Click"/>

        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#80FFFFFF" Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar IsIndeterminate="True" Width="250" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>