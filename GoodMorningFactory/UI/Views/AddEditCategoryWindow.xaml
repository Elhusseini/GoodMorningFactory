<Window x:Class="GoodMorningFactory.UI.Views.AddEditCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="350" Width="500"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditCategoryViewModel}">
	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<Label Grid.Row="0" Grid.Column="0" Content="كود الفئة (*):" VerticalAlignment="Center"/>
		<TextBox Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding CategoryCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"/>

		<Label Grid.Row="1" Grid.Column="0" Content="اسم الفئة (*):" VerticalAlignment="Center"/>
		<TextBox Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}"/>

		<Label Grid.Row="2" Grid.Column="0" Content="الوصف:" VerticalAlignment="Center"/>
		<TextBox Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding CategoryDescription, UpdateSourceTrigger=PropertyChanged}"/>

		<Label Grid.Row="3" Grid.Column="0" Content="الفئة الأم:" VerticalAlignment="Center"/>
		<ComboBox Grid.Row="3" Grid.Column="1" Margin="5"
                  ItemsSource="{Binding ParentCategories}"
                  SelectedItem="{Binding SelectedParentCategory}"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id"/>

		<StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Content="💾 حفظ" Width="120" IsDefault="True" Click="SaveButton_Click"/>
			<Button Content="إلغاء" Width="120" IsCancel="True" Margin="10,0,0,0"/>
		</StackPanel>
	</Grid>
</Window>