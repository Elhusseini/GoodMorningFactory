<UserControl x:Class="GoodMorningFactory.UI.Views.PriceListsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:PriceListsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Content="+ إضافة قائمة أسعار جديدة" Command="{Binding AddCommand}" HorizontalAlignment="Left" Margin="0,0,0,15"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding PriceLists}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم القائمة" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="3*"/>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="إدارة الأسعار" Margin="2" Background="ForestGreen" Foreground="White"
                                        Command="{Binding DataContext.ManagePricesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"/>
                                <Button Content="تعديل" Margin="2" 
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"/>
                                <Button Content="حذف" Margin="2" Background="IndianRed" Foreground="White"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>