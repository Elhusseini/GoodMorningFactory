<Window x:Class="GoodMorningFactory.UI.Views.AddEditJournalVoucherView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="إضافة قيد يومي جديد" Height="600" Width="950"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditJournalVoucherViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="معلومات القيد" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" Grid.Column="0" Content="رقم القيد:"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" Background="#EEE" Text="{Binding VoucherNumber}"/>
                <Label Grid.Row="0" Grid.Column="2" Content="التاريخ:"/>
                <DatePicker Grid.Row="0" Grid.Column="3" Margin="5" SelectedDate="{Binding VoucherDate}"/>
                <Label Grid.Row="1" Grid.Column="0" Content="الوصف:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="5" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </GroupBox>

        <DataGrid ItemsSource="{Binding Items}" Grid.Row="1" Margin="0,10" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridComboBoxColumn Header="الحساب" 
                                        SelectedValueBinding="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id" 
                                        Width="3*">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="DisplayMemberPath" Value="DisplayName"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="DisplayMemberPath" Value="DisplayName"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridTextColumn Header="مدين" Binding="{Binding Debit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="دائن" Binding="{Binding Credit, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                <DataGridTextColumn Header="الوصف" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridComboBoxColumn Header="مركز التكلفة" 
                                        ItemsSource="{Binding DataContext.CostCenters, RelativeSource={RelativeSource AncestorType=Window}}"
                                        DisplayMemberPath="Name" SelectedValuePath="Id" 
                                        SelectedValueBinding="{Binding CostCenterId, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="❌" 
                                    Command="{Binding ParentViewModel.DeleteItemCommand}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                                    Foreground="Red" ToolTip="حذف السطر"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Text="الحالة: " FontWeight="Bold"/>
                <TextBlock Text="{Binding BalanceStatusText}" FontWeight="Bold" Foreground="{Binding BalanceStatusColor}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="الإجمالي المدين: " FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalDebit, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text=" | الإجمالي الدائن: " FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalCredit, StringFormat=N2}" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="💾 حفظ القيد" Margin="20,0,0,0" Padding="10,5" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>