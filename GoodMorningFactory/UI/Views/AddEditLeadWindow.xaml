<Window x:Class="GoodMorningFactory.UI.Views.AddEditLeadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:GoodMorningFactory.UI.ViewModels"
        Title="إضافة عميل محتمل" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft">
    <Window.DataContext>
        <viewmodels:AddEditLeadViewModel/>
    </Window.DataContext>
    <StackPanel Margin="15">
        <Label Content="اسم الشركة (*):"/>
        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="شخص الاتصال:"/>
        <TextBox Text="{Binding ContactPerson, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="البريد الإلكتروني:"/>
        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="رقم الهاتف:"/>
        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="الحالة (*):"/>
        <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" SelectedValuePath="Value" DisplayMemberPath="Description"/>
        <Label Content="الموظف المسؤول:"/>
        <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username" SelectedValuePath="Id"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="حفظ" IsDefault="True" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>