<Window x:Class="GoodMorningFactory.UI.Views.StockTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        mc:Ignorable="d"
        Title="إنشاء تحويل مخزني جديد" Height="650" Width="900"
        FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:StockTransferViewModel, IsDesignTimeCreatable=True}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="تحويل مخزني جديد" Style="{DynamicResource TitleTextBlockStyle}" Grid.Row="0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Header="من (المصدر)" Grid.Column="0" Margin="5">
                <StackPanel>
                    <Label Content="المخزن الرئيسي:"/>
                    <ComboBox ItemsSource="{Binding SourceWarehouses}" SelectedItem="{Binding SelectedSourceWarehouse}" DisplayMemberPath="Name"/>
                    <Label Content="الموقع الفرعي:"/>
                    <ComboBox ItemsSource="{Binding SourceLocations}" SelectedItem="{Binding SelectedSourceLocation}" DisplayMemberPath="Name"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="إلى (الوجهة)" Grid.Column="1" Margin="5">
                <StackPanel>
                    <Label Content="المخزن الرئيسي:"/>
                    <ComboBox ItemsSource="{Binding DestinationWarehouses}" SelectedItem="{Binding SelectedDestinationWarehouse}" DisplayMemberPath="Name"/>
                    <Label Content="الموقع الفرعي:"/>
                    <ComboBox ItemsSource="{Binding DestinationLocations}" SelectedItem="{Binding SelectedDestinationLocation}" DisplayMemberPath="Name"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <GroupBox Header="الأصناف المراد تحويلها" Grid.Row="2" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Label Content="بحث عن منتج (بالكود أو الاسم):"/>
                    <TextBox Width="200" Text="{Binding ProductSearchText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSearchProduct}">
                        <i:Interaction.Triggers>
                            <i:KeyTrigger Key="Enter">
                                <i:InvokeCommandAction Command="{Binding SearchProductCommand}" />
                            </i:KeyTrigger>
                        </i:Interaction.Triggers>
                    </TextBox>
                </StackPanel>
                <DataGrid ItemsSource="{Binding ItemsToTransfer}" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود المنتج" Binding="{Binding ProductCode}" IsReadOnly="True" Width="Auto"/>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                        <DataGridTextColumn Header="الكمية المتاحة بالمصدر" Binding="{Binding AvailableQuantity}" IsReadOnly="True" Width="*"/>
                        <DataGridTextColumn Header="الكمية المراد تحويلها" Binding="{Binding QuantityToTransfer, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="إزالة" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{DynamicResource SecondaryButtonStyle}" Padding="5,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GroupBox Header="ملاحظات" Grid.Row="3" Margin="0,10,0,0">
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
        </GroupBox>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="تنفيذ التحويل" Style="{DynamicResource PrimaryButtonStyle}" Command="{Binding ExecuteTransferCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" Style="{DynamicResource SecondaryButtonStyle}" Margin="10,0,0,0" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>