<UserControl x:Class="GoodMorningFactory.UI.Views.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoodMorningFactory.UI.Views"
             xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             FlowDirection="RightToLeft"
             Background="#F5F5F5"
             d:DataContext="{d:DesignInstance Type=vm:RolesViewViewModel, IsDesignTimeCreatable=True}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10" Margin="0,0,0,10" Background="WhiteSmoke" CornerRadius="5">
            <Grid>
                <Button Command="{Binding AddRoleCommand}" Padding="10,5" HorizontalAlignment="Left" Background="#28a745" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="إضافة دور جديد"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="بحث:" VerticalAlignment="Center"/>
                    <TextBox Width="250" VerticalAlignment="Center" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Roles}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="اسم الدور" Binding="{Binding Name}" FontWeight="Bold" Width="*"/>
                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="2*"/>
                <DataGridTextColumn Header="عدد المستخدمين" Binding="{Binding UserCount}" Width="Auto"/>
                <DataGridTemplateColumn Header="إجراءات" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button ToolTip="إدارة الصلاحيات" Command="{Binding DataContext.ManagePermissionsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#007bff">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                                </Button>
                                <Button ToolTip="تعديل" Command="{Binding DataContext.EditRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#ffc107">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                                </Button>
                                <Button ToolTip="حذف" Command="{Binding DataContext.DeleteRoleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#dc3545">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Padding="5" Margin="0,10,0,0" Background="WhiteSmoke" CornerRadius="5">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="&lt; السابق" Command="{Binding PreviousPageCommand}" Margin="5,0"/>
                    <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="10,0"/>
                    <Button Content="التالي &gt;" Command="{Binding NextPageCommand}" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
