<Window x:Class="GoodMorningFactory.UI.Views.AddEditInventoryCountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:GoodMorningFactory.UI.ViewModels"
        xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="700" Width="900"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        d:DataContext="{d:DesignInstance Type=vm:AddEditInventoryCountViewModel, IsDesignTimeCreatable=True}">

    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Foreground" Value="#005A9C"/>
        </Style>

        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#EAEAEA"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E0E0E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource TitleTextBlockStyle}" Grid.Row="0"/>

        <Border Grid.Row="1" Style="{StaticResource SectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="الرقم المرجعي:" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceNumber}" IsReadOnly="True" Background="#eee"/>

                <TextBlock Text="تاريخ الجرد:" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}"/>
                <DatePicker Grid.Row="0" Grid.Column="3" SelectedDate="{Binding CountDate}"/>

                <TextBlock Text="المخزن الرئيسي:" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}" IsEnabled="{Binding IsReadOnly, Converter={StaticResource InverseBooleanConverter}}" DisplayMemberPath="Name"/>

                <TextBlock Text="المسؤول:" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username"/>

                <TextBlock Text="الحالة:" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" IsReadOnly="True" Background="#eee"/>

                <TextBlock Text="ملاحظات:" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}"/>
                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="40"/>

                <Button Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Left" Content="تحميل أصناف المخزن للجرد" Margin="5" Command="{Binding LoadProductsCommand}"/>
            </Grid>
        </Border>

        <DataGrid ItemsSource="{Binding Items}" Grid.Row="2" Style="{StaticResource DataGridStyle}" CanUserAddRows="False" IsReadOnly="{Binding IsReadOnly}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="كود المنتج" Binding="{Binding ProductCode}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="اسم المنتج" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="الموقع الفرعي" Binding="{Binding StorageLocationName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="كمية النظام" Binding="{Binding SystemQuantity}" Width="Auto" IsReadOnly="True"/>
                <DataGridTextColumn Header="الكمية الفعلية" Binding="{Binding CountedQuantity, UpdateSourceTrigger=PropertyChanged}" Width="Auto"/>
                <DataGridTextColumn Header="الفرق" Binding="{Binding Difference}" Width="Auto" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
            <Button Content="حفظ كمسودة" Margin="5" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveDraftCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="ترحيل الفروقات" Margin="5" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding PostCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="إلغاء" IsCancel="True" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>