<UserControl x:Class="GoodMorningFactory.UI.Views.ApprovalWorkflowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:GoodMorningFactory.UI.ViewModels"
             xmlns:converters="clr-namespace:GoodMorningFactory.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft" Background="WhiteSmoke">

    <UserControl.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <viewModels:ApprovalWorkflowsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: List of Workflows -->
        <GroupBox Header="دورات الموافقات المعرفة" Margin="0,0,10,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ListView Grid.Row="0" ItemsSource="{Binding Workflows}" SelectedItem="{Binding SelectedWorkflow, Mode=TwoWay}" DisplayMemberPath="Name"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="إضافة دورة جديدة" Command="{Binding AddNewWorkflowCommand}"/>
                    <Button Content="حذف الدورة" Margin="10,0,0,0" Command="{Binding DeleteWorkflowCommand}" Background="IndianRed"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Right Panel: Details of the Selected Workflow -->
        <GroupBox Header="تفاصيل الدورة" Grid.Column="1" IsEnabled="{Binding IsDetailsPanelEnabled}" Visibility="{Binding IsDetailsPanelEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <Label Content="اسم دورة الموافقة:"/>
                    <TextBox Text="{Binding SelectedWorkflow.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <Label Content="نوع المستند:"/>
                    <ComboBox ItemsSource="{Binding DocumentTypes}" 
                              SelectedValue="{Binding SelectedWorkflow.DocumentType, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Label Content="الحد الأدنى للمبلغ (لتفعيل الدورة):"/>
                    <TextBox Text="{Binding SelectedWorkflow.MinimumAmount, UpdateSourceTrigger=PropertyChanged}"/>

                    <CheckBox IsChecked="{Binding SelectedWorkflow.IsActive}" Content="فعالة" Margin="0,10,0,0"/>

                    <Separator Margin="0,20"/>

                    <TextBlock Text="خطوات الموافقة (بالترتيب)" FontSize="16" FontWeight="Bold"/>
                    <!-- CanUserAddRows is now False because we use the button -->
                    <DataGrid ItemsSource="{Binding SelectedWorkflow.Steps}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الترتيب" Binding="{Binding StepOrder}" IsReadOnly="True" Width="Auto"/>
                            <DataGridTextColumn Header="اسم الخطوة" Binding="{Binding StepName, UpdateSourceTrigger=PropertyChanged}" Width="*"/>

                            <DataGridTemplateColumn Header="الدور المسؤول" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValue="{Binding ApproverRoleId, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف" Command="{Binding DataContext.DeleteStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="Red" Background="Transparent" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <!-- الربط الآن مباشر وبسيط -->
                        <Button Content="إضافة خطوة" Command="{Binding AddStepCommand}"/>
                        <Button Content="حفظ التغييرات" Command="{Binding SaveChangesCommand}" HorizontalAlignment="Left" Margin="10,0,0,0" Background="LightGreen"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
